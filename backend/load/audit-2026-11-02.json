  "findings": [
    {
      "severity": "critical",
      "kind": "reproduced correctness defect",
      "source": "backend/sockets/match.ts:442",
      "finding": "Candidate selection and removal are separated by awaits; candidate is not atomically reserved or revalidated before partner fields are overwritten. Repeated match_found and asymmetric partners reproduced at 100, 1000 and 5000 clients."
    },
    {
      "severity": "high",
      "kind": "measured object size; calculated fanout",
      "source": "backend/utils/welcomeOnlinePresence.ts:74",
      "finding": "Full online snapshot broadcast to all clients. At 5000 users, empty-name snapshot is 290020 bytes; aggregate payload before compression is 1450100000 bytes per broadcast. Wire bandwidth and its exact causal contribution to disconnects were not measured."
    },
    {
      "severity": "medium",
      "kind": "observed local explain plan",
      "source": "backend/models/OfflineMessage.ts:102",
      "finding": "Claim sort uses createdAt,_id; current recipientId,createdAt index leaves a blocking SORT. Actual production index inventory not queried."
    },
    {
      "severity": "medium",
      "kind": "code inspection; backlog test passed at 1000 records",
      "source": "backend/sockets/messagesReliable.ts:692",
      "finding": "Claims entire recipient backlog into memory with serial DB operations before delivery; no batch or in-flight acknowledgement bound."
    },
    {
      "severity": "medium",
      "kind": "code inspection",
      "source": "frontend/sockets/modules/outbox.ts:353",
      "finding": "Durable outbox rewrites one JSON array and has no count/byte admission bound. A safe overflow policy must preserve pending user messages."
    },
    {
      "severity": "medium",
      "kind": "code inspection",
      "source": "backend/index.ts:264",
      "finding": "Global JSON and urlencoded body limits are 50MB before route authentication; message text limits do not prevent large-body parsing cost."
    },
    {
      "severity": "high",
      "kind": "architectural limitation",
      "source": "backend/sockets/match.ts:43",
      "finding": "Random matchmaking, reservation guard and reconnect-held pairs are process-local and safeGet reads local sockets. Redis adapter alone does not make matching multi-instance."
    }
  ],

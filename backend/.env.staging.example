# Backend staging (Capacity Stage A). Скопируйте в .env.staging и заполните.
# DoD: 3 SFU, TURN pool (отдельно от SFU), managed Redis с failover — см. docs/capacity/DOD_STAGING_INFRASTRUCTURE.md

# MongoDB (отдельный инстанс/кластер для staging)
MONGO_URI=mongodb://...

# LiveKit: URL должен вести на балансировщик перед 3 нодами SFU (DoD)
LIVEKIT_URL=wss://livekit.staging.liviapp.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TURN: отдельный пул (не на SFU), multi-AZ в облаке. TURN_SECRET должен совпадать с coturn.
TURN_HOST=turn.staging.liviapp.com
TURN_SECRET=
TURN_PORT=3478
TURN_ENABLE_TCP=1
TURN_ENABLE_TCP_443=0

# Второй TURN (дополнительный VPS): для лучшей доступности и распределения нагрузки.
# Заполните, если подняли coturn на втором сервере. Клиенты получат оба TURN в iceServers.
# TURN_SECRET_2 — shared secret из конфига coturn на втором VPS (может совпадать с TURN_SECRET или быть своим).
TURN_HOST_2=
TURN_SECRET_2=
TURN_PORT_2=3478
TURN_ENABLE_TCP_2=1
TURN_ENABLE_TCP_443_2=0

# Redis: для DoD обязателен managed Redis с failover; укажите его URL здесь.
# При локальном docker-compose можно REDIS_URL=redis://redis:6379 (контейнер из docker-compose.staging.yml).
REDIS_URL=redis://redis:6379

# Capacity метрики: только на staging. В проде не задавать — тогда /api/capacity/* и /metrics отдают 404.
CAPACITY_METRICS_ENABLED=1

# Остальное (порт, NODE_ENV, JWT и т.д.) — по необходимости
# NODE_ENV=staging
# PORT=3000

<resources>
  <!-- Let Android select the icon for an ordinary cold launcher start.
       Do not force it on warm task returns: Android can recreate that starting
       window without the answer intent's SOLID_COLOR ActivityOptions. Native
       message/missed notifications explicitly request ICON in their options. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <!-- Keep the activity fallback plain during an answered-call handoff. -->
    <item name="android:windowBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splashscreen_icon</item>
  </style>
</resources>

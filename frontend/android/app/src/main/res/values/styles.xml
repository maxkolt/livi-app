<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Android 16 (targetSdk 36): edge-to-edge is enforced; windowOptOutEdgeToEdgeEnforcement is ignored.
    Draw under system bars; RN screens pad via react-native-safe-area-context.

    windowLayoutInDisplayCutoutMode:
    - omitted below API 28 (attribute does not exist)
    - shortEdges on API 28–29 (values-v28) — ALWAYS(3) crashes PhoneWindow on Android 9/10
    - always on API 30+ (values-v30)
  -->
  <style name="AppTheme.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <!-- statusBarColor/navigationBarColor/enforce*Contrast убраны: задепрекейчены на Android 15/16
         (Google Play флагует их как edge-to-edge unsupported API). Прозрачность баров задаётся в
         рантайме EdgeToEdgeHelper.apply() (guarded для Android <=14), поэтому вид не меняется. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <!-- Во время анимации поворота система показывает снимок старого кадра, а поля
         вокруг него закрашивает windowBackground. Без этого по краям была чёрная
         рамка, не совпадающая с фоном приложения. -->
    <item name="android:windowBackground">@color/window_background</item>
  </style>
  <style name="AppTheme" parent="AppTheme.Base" />
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/ic_launcher_background</item>
  </style>
  <!-- Прозрачная тема при запуске только для decline-call: пользователь видит экран блокировки/лаунчер, не страницу приветствия -->
  <style name="Theme.App.Translucent.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
  </style>
  <style name="Theme.App.Translucent" parent="Theme.App.Translucent.Base" />
</resources>

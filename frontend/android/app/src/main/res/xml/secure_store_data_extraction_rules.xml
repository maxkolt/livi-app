<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила для Android 12+ (cloud backup + device-to-device transfer).
  См. secure_store_backup_rules.xml — та же логика: по умолчанию ничего не переносим,
  install_id/install_secret и прочие идентификаторы сессии остаются только на устройстве.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>

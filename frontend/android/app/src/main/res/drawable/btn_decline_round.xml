<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/incoming_btn_decline_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/incoming_btn_decline_border_pressed" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/incoming_btn_decline_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/incoming_btn_decline_border_pressed" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/incoming_btn_decline_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/incoming_btn_decline_border" />
        </shape>
    </item>
</selector>

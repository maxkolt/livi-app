<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон окна = фон сцены из JS (WelcomeStageBackground): тот же PNG, растянутый на
  всё окно. При повороте RN ещё какое-то время рисует старую раскладку, и в
  непокрытых полосах виден именно этот фон — поэтому он совпадает с экраном.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@color/window_background" />
  <item>
    <bitmap
      android:src="@drawable/welcome_stage_bg"
      android:gravity="fill"
      android:filter="true"
      android:dither="true" />
  </item>
</layer-list>

<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <!-- Показ поверх других окон: LiVi появляется в системных настройках; включение только вручную пользователем. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <!-- CallKeep: foreground service для микрофона в фоне при звонке (Android 11+) -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
  <!-- Remove permissions merged from dependencies to satisfy Play policy. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE" android:maxSdkVersion="29" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:requestLegacyExternalStorage="false" android:fullBackupContent="@xml/secure_store_backup_rules" android:dataExtractionRules="@xml/secure_store_data_extraction_rules" tools:replace="android:allowBackup,android:requestLegacyExternalStorage">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <!-- Убираем дефолтный FCM-сервис Expo, подменяем своим (расширяет Expo): звонок → headless → CallKeep. -->
    <service
      android:name="expo.modules.notifications.service.ExpoFirebaseMessagingService"
      tools:node="remove"
      xmlns:tools="http://schemas.android.com/tools"/>
    <!-- Высокий приоритет: гарантированно получаем FCM (входящий звонок, сообщения, call_canceled) до любых других обработчиков -->
    <service
      android:name=".LiviFirebaseMessagingService"
      android:exported="false"
      android:directBootAware="true">
      <intent-filter android:priority="999">
        <action android:name="com.google.firebase.MESSAGING_EVENT"/>
      </intent-filter>
    </service>
    <!-- CallKeep: headless-задача при FCM входящего — поднимает JS и показывает системный экран звонка (как Telegram) -->
    <service android:name="io.wazo.callkeep.RNCallKeepBackgroundMessagingService" android:exported="false"/>
    <!-- CallKeep: ConnectionService для нативного экрана входящего звонка (Android) -->
    <service
      android:name="io.wazo.callkeep.VoiceConnectionService"
      android:label="@string/app_name"
      android:exported="true"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
      android:foregroundServiceType="microphone">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService"/>
      </intent-filter>
    </service>
    <!-- Ориентация приложения зафиксирована в портретном режиме. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize"
      android:exported="true"
      android:launchMode="singleTask"
      android:resizeableActivity="true"
      android:screenOrientation="portrait"
      android:showWhenLocked="true"
      android:supportsPictureInPicture="true"
      android:theme="@style/Theme.App.SplashScreen"
      android:turnScreenOn="true"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="livi"/>
        <data android:scheme="exp+livi-video-chat"/>
      </intent-filter>
      <intent-filter data-generated="true">
        <action android:name="android.intent.action.VIEW"/>
        <data android:scheme="https"/>
        <data android:scheme="exp+livi-video-chat"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="livi" android:host="incoming-call"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="livi" android:host="answer-call"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="livi" android:host="decline-call"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="livi" android:host="cancel-outgoing"/>
      </intent-filter>
      <!-- Системное «Поделиться»: фото, текст/ссылки, файлы (без video/*). -->
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="text/plain"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="application/*"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="audio/*"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
    </activity>
    <!-- Full-screen incoming call (WhatsApp/Telegram style): показывается поверх блокировки при FCM-пуше о звонке -->
    <activity android:name=".IncomingCallActivity" android:exported="false" android:theme="@style/Theme.App.SplashScreen" android:showWhenLocked="true" android:turnScreenOn="true" android:launchMode="singleInstance" android:finishOnTaskLaunch="false" android:screenOrientation="portrait"/>
    <!-- Нативный экран исходящего видеозвонка (вместо in-app модалки при CallKeep) -->
    <activity android:name=".OutgoingCallActivity" android:exported="false" android:theme="@style/Theme.App.SplashScreen" android:showWhenLocked="true" android:turnScreenOn="true" android:launchMode="singleInstance" android:finishOnTaskLaunch="false" android:screenOrientation="portrait"/>
    <!-- ML Kit activity также зафиксирована в портретном режиме. -->
    <activity
      android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
      android:screenOrientation="portrait"
      tools:replace="android:screenOrientation" />
    <!-- Исходящий вызов в фоне: WAV в динамике, уведомление, таймаут 20 сек -->
    <service android:name=".LiviOutgoingCallService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
    <!-- Входящий звонок: foreground-сервис типа phoneCall (Android 14+) — без ограничения камеры/микрофона при старте из фона; на старых версиях — specialUse -->
    <service android:name=".IncomingCallForegroundService" android:exported="false" android:foregroundServiceType="phoneCall|specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Display incoming video call screen over other apps"/>
    </service>
    <!-- Активный видеозвонок: держим процесс в foreground, чтобы сокет не засыпал в фоне/PiP -->
    <service android:name=".ActiveCallForegroundService" android:exported="false" android:foregroundServiceType="phoneCall|microphone"/>
    <!-- WebRTC screen-share FGS (mediaProjection): не используем в LiVi; убираем из merge — иначе Play ругается на BOOT_COMPLETED + Android 15. -->
    <service
      android:name="com.oney.WebRTCModule.MediaProjectionService"
      tools:node="remove" />
    <!-- «Отклонить» в уведомлении: HTTP decline без открытия приложения (нет Deep link received) -->
    <receiver android:name=".DeclineCallReceiver" android:exported="false">
      <intent-filter>
        <action android:name="com.kolt12max.livi.DECLINE_CALL"/>
      </intent-filter>
    </receiver>
    <!-- Пользователь смахнул уведомление «Пропущенный вызов» — обнулить счётчик для этого userId -->
    <receiver android:name=".MissedCallDismissedReceiver" android:exported="false">
      <intent-filter>
        <action android:name="com.kolt12max.livi.MISSED_CALL_DISMISSED"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
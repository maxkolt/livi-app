## Local Android release signing config (DO NOT COMMIT secrets)
#
# Copy this file to `keystore.properties` (same folder) and fill values,
# or provide them via environment variables / ~/.gradle/gradle.properties.
#
# Supported keys (see android/app/build.gradle):
# - LIVI_RELEASE_STORE_FILE (path to .jks, default: livi-release.jks)
# - LIVI_RELEASE_STORE_PASSWORD
# - LIVI_RELEASE_KEY_ALIAS
# - LIVI_RELEASE_KEY_PASSWORD
#
# Example:
# LIVI_RELEASE_STORE_FILE=livi-release.jks
# LIVI_RELEASE_STORE_PASSWORD=***
# LIVI_RELEASE_KEY_ALIAS=livi
# LIVI_RELEASE_KEY_PASSWORD=***

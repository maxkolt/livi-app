{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-native",
    "types": [
      "react",
      "node",
      "jest"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./"
    ],
    "paths": {
      "*": [
        "./*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "**/*.old.tsx"
  ],
  "include": [
    "src",
    "components",
    "utils",
    "livekit",
    "screens",
    "sockets",
    "store",
    "hooks",
    "constants",
    "theme",
    "App.tsx",
    "index.tsx",
    "global.d.ts"
  ]
}

#
# Copy to `frontend/.env` for local development (expo start).
# IMPORTANT:
# - Only variables prefixed with EXPO_PUBLIC_ are embedded into the JS bundle.
# - Never put secrets here (no API secrets, no private keys).
#

# Base URL of your backend API (HTTPS domain recommended for real devices)
EXPO_PUBLIC_SERVER_URL=https://api.liviapp.com

# Optional per-platform overrides (if needed)
# EXPO_PUBLIC_SERVER_URL_IOS=https://api.liviapp.com
# EXPO_PUBLIC_SERVER_URL_ANDROID=https://api.liviapp.com

# LiveKit WebSocket URL.
# If omitted, the app can still work by using `url` / `livekitUrl` provided by backend payloads.
# Recommended: keep it consistent with backend LIVEKIT_URL.
EXPO_PUBLIC_LIVEKIT_URL=wss://livekit.liviapp.com

# LiveKit client scaling flags.
# Safe profile for this app: dynacast ON, adaptiveStream OFF.
# Set to 1 to enable, 0 to disable.
# EXPO_PUBLIC_LIVEKIT_DYNACAST=1
# EXPO_PUBLIC_LIVEKIT_ADAPTIVE_STREAM=0

# --- Staging (Capacity Stage A: 500 concurrent) ---
# Use staging profile in eas.json (build profile "staging") or set for local .env when pointing at staging:
# EXPO_PUBLIC_SERVER_URL=https://api.staging.liviapp.com
# EXPO_PUBLIC_LIVEKIT_URL=wss://livekit.staging.liviapp.com
# EXPO_PUBLIC_LIVEKIT_DYNACAST=1
# EXPO_PUBLIC_LIVEKIT_ADAPTIVE_STREAM=0
# Guards (next/reconnect) remain enabled; do not disable.
#
# Dev build + Metro against staging (no APK rebuild):
# - .env.development already contains staging URLs.
# - Run: npm run start:staging   (or npm run start:usb:staging for USB device).
# - One dev APK on the phone will use staging API/LiveKit; JS changes apply via Fast Refresh.

# Logging verbosity: debug | info | warn | error
EXPO_PUBLIC_LOG_LEVEL=info
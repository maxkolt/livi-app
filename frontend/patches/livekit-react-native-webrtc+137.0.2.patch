+package com.oney.WebRTCModule;
+
+import android.content.Context;
+import android.graphics.Point;
+import android.graphics.SurfaceTexture;
+import android.view.TextureView;
+
+import org.webrtc.EglBase;
+import org.webrtc.EglRenderer;
+import org.webrtc.GlRectDrawer;
+import org.webrtc.RendererCommon;
+import org.webrtc.ThreadUtils;
+import org.webrtc.VideoFrame;
+import org.webrtc.VideoSink;
+
+import java.util.concurrent.CountDownLatch;
+
+/**
+ * Same contract as {@link org.webrtc.SurfaceViewRenderer}, but draws into a TextureView.
+ *
+ * LiVi: a SurfaceView is composited by the system outside the window's display list, so app
+ * glass (RenderNode + RenderEffect blur, BackdropBlur.kt) cannot see the video under it. A
+ * TextureView is part of the display list: the call screen's controls can blur the remote video.
+ * Opt-in per RTCView ({@code textureView}); everything else keeps SurfaceView.
+ */
+public class TextureViewRenderer extends TextureView implements TextureView.SurfaceTextureListener, VideoSink {
+    private final RendererCommon.VideoLayoutMeasure videoLayoutMeasure = new RendererCommon.VideoLayoutMeasure();
+    private final Renderer eglRenderer;
+    private RendererCommon.RendererEvents rendererEvents;
+    private final Object layoutLock = new Object();
+    private int rotatedFrameWidth;
+    private int rotatedFrameHeight;
+    private int frameRotation;
+    private boolean isFirstFrameRendered;
+
+    public TextureViewRenderer(Context context) {
+        super(context);
+        eglRenderer = new Renderer("LiviTextureViewRenderer");
+        setSurfaceTextureListener(this);
+        // Пока кадра нет, TextureView прозрачен — под ним фон экрана, как у SurfaceView.
+        setOpaque(false);
+    }
+
+    public void init(EglBase.Context sharedContext, RendererCommon.RendererEvents rendererEvents) {
+        ThreadUtils.checkIsOnMainThread();
+        this.rendererEvents = rendererEvents;
+        synchronized (layoutLock) {
+            rotatedFrameWidth = 0;
+            rotatedFrameHeight = 0;
+            frameRotation = 0;
+            isFirstFrameRendered = false;
+        }
+        eglRenderer.init(sharedContext, EglBase.CONFIG_RGBA, new GlRectDrawer());
+        SurfaceTexture st = getSurfaceTexture();
+        if (st != null) eglRenderer.createEglSurface(st);
+    }
+
+    public void release() {
+        eglRenderer.release();
+    }
+
+    public void setMirror(boolean mirror) {
+        eglRenderer.setMirror(mirror);
+    }
+
+    public void setScalingType(RendererCommon.ScalingType scalingType) {
+        ThreadUtils.checkIsOnMainThread();
+        videoLayoutMeasure.setScalingType(scalingType);
+        requestLayout();
+    }
+
+    public void clearImage() {
+        eglRenderer.clearImage();
+    }
+
+    @Override
+    public void onFrame(VideoFrame frame) {
+        eglRenderer.onFrame(frame);
+    }
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        ThreadUtils.checkIsOnMainThread();
+        Point size;
+        synchronized (layoutLock) {
+            size = videoLayoutMeasure.measure(widthSpec, heightSpec, rotatedFrameWidth, rotatedFrameHeight);
+        }
+        setMeasuredDimension(size.x, size.y);
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        super.onLayout(changed, left, top, right, bottom);
+        int h = bottom - top;
+        if (h > 0) eglRenderer.setLayoutAspectRatio((right - left) / (float) h);
+    }
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture surface, int width, int height) {
+        ThreadUtils.checkIsOnMainThread();
+        eglRenderer.createEglSurface(surface);
+    }
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture surface, int width, int height) {}
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture surface) {
+        ThreadUtils.checkIsOnMainThread();
+        CountDownLatch done = new CountDownLatch(1);
+        eglRenderer.releaseEglSurface(done::countDown);
+        ThreadUtils.awaitUninterruptibly(done);
+        return true;
+    }
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture surface) {}
+
+    /** EglRenderer + first-frame / resolution events, as org.webrtc.SurfaceEglRenderer. */
+    private final class Renderer extends EglRenderer {
+        Renderer(String name) {
+            super(name);
+        }
+
+        @Override
+        public void onFrame(VideoFrame frame) {
+            reportEvents(frame);
+            super.onFrame(frame);
+        }
+
+        private void reportEvents(VideoFrame frame) {
+            RendererCommon.RendererEvents events = rendererEvents;
+            boolean first = false;
+            boolean resized = false;
+            synchronized (layoutLock) {
+                if (!isFirstFrameRendered) {
+                    isFirstFrameRendered = true;
+                    first = true;
+                }
+                if (rotatedFrameWidth != frame.getRotatedWidth()
+                        || rotatedFrameHeight != frame.getRotatedHeight()
+                        || frameRotation != frame.getRotation()) {
+                    rotatedFrameWidth = frame.getRotatedWidth();
+                    rotatedFrameHeight = frame.getRotatedHeight();
+                    frameRotation = frame.getRotation();
+                    resized = true;
+                }
+            }
+            if (events == null) return;
+            if (first) events.onFirstFrameRendered();
+            if (resized) {
+                events.onFrameResolutionChanged(
+                        frame.getBuffer().getWidth(), frame.getBuffer().getHeight(), frame.getRotation());
+                post(TextureViewRenderer.this::requestLayout);
+            }
+        }
+    }
+}

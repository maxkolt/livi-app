+  // LiVi: a live call owns MODE_IN_COMMUNICATION and the communication device. Chat focus calls
+  // setAudioModeAsync, which dropped the call to MODE_NORMAL (silent mic/peer) for several seconds.
+  private static boolean isHostCallActive() {
+    try {
+      Class<?> host = Class.forName("com.kolt12max.livi.LiviAppModule");
+      boolean running = (Boolean) host.getMethod("isActiveCallForegroundRunning").invoke(null);
+      boolean ending = (Boolean) host.getMethod("getEndingCallInProgress").invoke(null);
+      return running && !ending;
+    } catch (Throwable t) {
+      return false;
+    }
+  }
+
   private void updatePlaySoundThroughEarpiece(boolean playThroughEarpiece) {
+    if (isHostCallActive()) {
+      Log.i("AVManager", "Skip audio mode change: LiVi call owns the audio route");
+      return;
+    }
     mAudioManager.setMode(playThroughEarpiece ? AudioManager.MODE_IN_COMMUNICATION : AudioManager.MODE_NORMAL);
+    if (!playThroughEarpiece && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+      // Android 12+: setSpeakerphoneOn(true) is a lasting communication-device request that the
+      // system re-applies whenever the app enters MODE_IN_COMMUNICATION, so calls and the
+      // outgoing ringback started on the loudspeaker. Normal-mode playback needs no request.
+      mAudioManager.clearCommunicationDevice();
+      return;
+    }
     mAudioManager.setSpeakerphoneOn(!playThroughEarpiece);
   }
 

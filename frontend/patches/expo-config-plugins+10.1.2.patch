diff --git a/build/android/Package.js b/build/android/Package.js
--- a/build/android/Package.js
+++ b/build/android/Package.js
@@ -282,7 +282,13 @@ async function getApplicationIdAsync(projectRoot) {
   const buildGradle = await _fs().default.promises.readFile(buildGradlePath, 'utf8');

+++ b/android/src/main/java/com/facebook/react/uimanager/SafeAreaViewHierarchyLock.java
@@ -0,0 +1,23 @@
+package com.facebook.react.uimanager;
+
+/**
+ * Lives in React Native's package to reach the package-private view hierarchy manager (the same
+ * trick as Reanimated's ReanimatedUIManager).
+ *
+ * <p>Paper runs every UI operation (createView, manageChildren, updateProperties) while holding the
+ * NativeViewHierarchyManager monitor, and UIManagerModule.onBatchComplete on the native modules
+ * thread takes the same monitor. SafeAreaView must not block the UI thread waiting for that thread
+ * while the monitor is held, or both threads wait for each other until the timeout.
+ */
+public final class SafeAreaViewHierarchyLock {
+  private SafeAreaViewHierarchyLock() {}
+
+  public static boolean isHeldByCurrentThread(UIManagerModule uiManager) {
+    try {
+      return Thread.holdsLock(
+          uiManager.getUIImplementation().getUIViewOperationQueue().getNativeViewHierarchyManager());
+    } catch (Throwable ignored) {
+      return false;
+    }
+  }
+}
